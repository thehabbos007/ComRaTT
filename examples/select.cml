chan A1 : int;
chan A2 : int;
chan A3 : int;

react : O int
def react =
    let a1 = wait A1 in
    let a2 = wait A2 in
    let a3 = wait A3 in
    let lefty = delay { cl(a1) U cl(a2)} (
        // This value is not used
        9
    ) in
    let righty = delay {cl(a2) U cl(a3) } (
        // This value is not used
        18
    ) in
    delay {cl(lefty) U cl(righty)} (
    select lefty righty {
        // Channel index 0
        left l1 l2 -> 1
        // Channel index 2
        right r1 r2 -> 2
        // Channel index 1
        both b1 b2 -> 42
    });


print <- react;
